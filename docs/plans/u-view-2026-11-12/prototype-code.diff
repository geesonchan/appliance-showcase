--- /dev/null
+++ b/src/protoSwitch.ts
@@ -0,0 +1,85 @@
+// PROTOTYPE ONLY (Leo, 2026-11-12: 「我用你上面给的角度的三个链接，但链接没能正确固定角度」): a
+// panel on the page to switch the U's default view between the candidates without
+// editing the link. Each button writes the view into the address and into this
+// browser's storage (so a link that lost its tail still opens at the last pick) and
+// presses "reset view". The board needs the room rebuilt, so it reloads the page.
+const VIEWS: [string, number, number][] = [
+  ["正前方·往下50°", 0, 50],
+  ["正前方·往下55°", 0, 55],
+  ["正前方·往下60°", 0, 60],
+  ["现在：往左45°·往下25°", -45, 25],
+];
+
+export function protoView(): { az: number; pitch: number } | null {
+  const q = new URLSearchParams(window.location.search);
+  if (q.has("protoAz") || q.has("protoPitch")) {
+    return { az: Number(q.get("protoAz") ?? -45), pitch: Number(q.get("protoPitch") ?? 25) };
+  }
+  try {
+    const kept = JSON.parse(localStorage.getItem("protoView") ?? "null");
+    if (kept && typeof kept.az === "number" && typeof kept.pitch === "number") return kept;
+  } catch {
+    /* storage blocked: the default */
+  }
+  return null;
+}
+
+function setQuery(values: Record<string, string>) {
+  const q = new URLSearchParams(window.location.search);
+  for (const [k, v] of Object.entries(values)) q.set(k, v);
+  history.replaceState(null, "", `${window.location.pathname}?${q}`);
+}
+
+export function mountProtoSwitch() {
+  const panel = document.createElement("div");
+  panel.setAttribute("data-proto-switch", "");
+  panel.style.cssText =
+    "position:fixed;top:72px;left:52px;z-index:60;display:flex;flex-direction:column;gap:6px;align-items:stretch;width:170px;" +
+    "padding:6px 10px;background:#fff8e1;border:1px solid #e0b84c;border-radius:10px;font:12px system-ui,'Microsoft YaHei',sans-serif;box-shadow:0 2px 8px rgba(0,0,0,.12)";
+  const title = document.createElement("span");
+  title.textContent = "原型·U 默认视角：";
+  title.style.fontWeight = "600";
+  panel.append(title);
+  const buttons: [HTMLButtonElement, number, number][] = [];
+  const paint = () => {
+    const now = protoView() ?? { az: -45, pitch: 25 };
+    for (const [b, az, pitch] of buttons) {
+      const on = now.az === az && now.pitch === pitch;
+      b.style.background = on ? "#2f5d46" : "#fff";
+      b.style.color = on ? "#fff" : "#222";
+    }
+  };
+  for (const [label, az, pitch] of VIEWS) {
+    const b = document.createElement("button");
+    b.type = "button";
+    b.textContent = label;
+    b.style.cssText = "padding:3px 8px;border:1px solid #bbb;border-radius:6px;cursor:pointer";
+    b.addEventListener("click", () => {
+      setQuery({ protoAz: String(az), protoPitch: String(pitch) });
+      try {
+        localStorage.setItem("protoView", JSON.stringify({ az, pitch }));
+      } catch {
+        /* storage blocked: the address carries it */
+      }
+      paint();
+      const reset = [...document.querySelectorAll<HTMLButtonElement>("button")].find((x) =>
+        ["重置视角", "Reset view"].includes(x.getAttribute("aria-label") ?? ""),
+      );
+      reset?.click();
+    });
+    buttons.push([b, az, pitch]);
+    panel.append(b);
+  }
+  const board = document.createElement("button");
+  board.type = "button";
+  const boardOn = () => (new URLSearchParams(window.location.search).get("protoBoard") ?? "both") !== "none";
+  board.textContent = boardOn() ? "背板：有（点一下去掉）" : "背板：没有（点一下加上）";
+  board.style.cssText = "padding:3px 8px;border:1px solid #bbb;border-radius:6px;cursor:pointer;margin-top:6px";
+  board.addEventListener("click", () => {
+    setQuery({ protoBoard: boardOn() ? "none" : "both" });
+    window.location.reload();
+  });
+  panel.append(board);
+  document.body.append(panel);
+  paint();
+}
