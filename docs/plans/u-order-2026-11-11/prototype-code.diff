--- /dev/null
+++ b/src/data/defaultView.ts
@@ -0,0 +1,23 @@
+import type { LayoutShape } from "./layoutShape";
+
+/**
+ * The angle the room is first seen from, and gone back to by "reset view".
+ *
+ * The L and one wall from front right, 45° round and 35° down (§10, the
+ * isometric default since the first commit). The U from straight in front, 45°
+ * down (U-2; Leo, 2026-11-11: 「U 的默认视角从正前方看：同意」): from front right
+ * the right leg turns its back to the camera, its doors facing the left leg.
+ *
+ * Only the default: switching the shape leaves the camera where it is (D1).
+ */
+export function defaultView(shape: LayoutShape): { azimuthDeg: number; pitchDeg: number } {
+  // PROTOTYPE (Leo, 2026-11-11: 「U型默认视角太陡了，放平一点」): the U's pitch from
+  // `?protoPitch=`, 30° when the link does not say.
+  const asked = typeof window === "undefined" ? NaN : Number(new URLSearchParams(window.location.search).get("protoPitch"));
+  // Leo, 2026-11-12: 25° down, and three ways round to compare — `?protoAz=45`
+  // (from the right), `-45` (from the left), `0` (from in front); 45 when the link does not say.
+  const pitchDeg = Number.isFinite(asked) && asked > 0 ? asked : 25;
+  const az = typeof window === "undefined" ? NaN : Number(new URLSearchParams(window.location.search).get("protoAz") ?? "45");
+  const azimuthDeg = Number.isFinite(az) ? az : 45;
+  return shape === "U" ? { azimuthDeg, pitchDeg } : { azimuthDeg: 45, pitchDeg: 35 };
+}
