  "rules": [
    {
      "id": "power-upgrade",
      "severity": "blocker",
      "messageKey": "rule.powerUpgrade",
      "when": [
        {
          "fact": "appliance.requires.voltage",
          "op": "gt",
          "value": "slot.utilities.power.voltage"
        }
      ],
      "params": {
        "voltage": "appliance.requires.voltage",
        "amps": "appliance.requires.amps"
      },
      "scope": "slot"
    },
    {
      "id": "amp-upgrade",
      "severity": "warning",
      "messageKey": "rule.ampUpgrade",
      "when": [
        {
          "fact": "appliance.requires.voltage",
          "op": "eq",
          "value": "slot.utilities.power.voltage"
        },
        {
          "fact": "appliance.requires.amps",
          "op": "gt",
          "value": "slot.utilities.power.amps"
        }
      ],
      "params": {
        "amps": "appliance.requires.amps"
      },
      "scope": "slot"
    },
    {
      "id": "dual-fuel",
      "severity": "warning",
      "messageKey": "rule.dualFuel",
      "when": [
        {
          "fact": "appliance.fuel",
          "op": "eq",
          "value": "dual"
        }
      ],
      "params": {},
      "scope": "slot"
    },
    {
      "id": "gas-line-missing",
      "severity": "blocker",
      "messageKey": "rule.gasLineMissing",
      "when": [
        {
          "fact": "appliance.requires.gasBTU",
          "op": "gt",
          "value": 0
        },
        {
          "fact": "slot.utilities.gas",
          "op": "isNull"
        }
      ],
      "params": {
        "btu": "appliance.requires.gasBTU"
      },
      "scope": "slot"
    },
    {
      "id": "gas-pipe-size",
      "severity": "info",
      "messageKey": "rule.gasPipeSize",
      "when": [
        {
          "fact": "appliance.requires.gasBTU",
          "op": "gt",
          "value": 65000
        }
      ],
      "params": {
        "btu": "appliance.requires.gasBTU",
        "pipe": "3/4\""
      },
      "scope": "slot"
    },
    {
      "id": "blower-missing",
      "severity": "blocker",
      "messageKey": "rule.blowerMissing",
      "when": [
        {
          "fact": "appliance.blower",
          "op": "eq",
          "value": "required"
        },
        {
          "fact": "package.blower",
          "op": "isNull"
        }
      ],
      "params": {},
      "scope": "slot"
    },
    {
      "id": "makeup-air",
      "severity": "warning",
      "messageKey": "rule.makeupAir",
      "when": [
        {
          "fact": "package.effectiveCfm",
          "op": "gte",
          "value": 400
        }
      ],
      "params": {
        "cfm": "package.effectiveCfm"
      },
      "scope": "package"
    },
    {
      "id": "hood-narrower-than-cooking",
      "severity": "warning",
      "messageKey": "rule.hoodNarrow",
      "when": [
        {
          "fact": "package.hoodNarrowerByIn",
          "op": "gt",
          "value": 1
        }
      ],
      "params": {
        "hood": "package.hoodWidthText",
        "cooking": "package.cookingWidthText"
      },
      "scope": "package",
      "basis": "Leo's site practice, round 79, his words: \"一般 Hood 宽度是大于等于炉头的宽度的\". A reminder, not a refusal. The 1\" allowance is a display figure with no outside source (Leo): hoods and cooking surfaces come in 30\", 36\" and 42\", six inches apart, so 1\" is clear of a nominal 30\" measured as 29-7/8\" and clear of the next size down. An insert liner counts as its housing, the hood slot's width."
    },
    {
      "id": "duct-size",
      "severity": "info",
      "messageKey": "rule.ductSize",
      "when": [
        {
          "fact": "package.effectiveCfm",
          "op": "gt",
          "value": 0
