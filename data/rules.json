          "op": "ne",
          "value": "otr"
        }
      ],
      "params": {
        "cfm": "package.effectiveCfm",
        "duct": "package.ductDiameterIn"
      },
      "scope": "package"
    },
    {
      "id": "duct-size-otr",
      "severity": "info",
      "messageKey": "rule.ductSizeOtr",
      "when": [
        {
          "fact": "appliance.category",
          "op": "eq",
          "value": "otr"
