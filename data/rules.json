      "when": [
        {
          "fact": "appliance.requires.voltage",
          "op": "eq",
          "value": "slot.utilities.power.voltage"
        },
        {
          "fact": "appliance.requires.amps",
          "op": "gt",
          "value": "slot.utilities.power.amps"
        }
      ],
      "params": {
        "amps": "appliance.requires.amps"
      },
      "scope": "slot"
    },
    {
